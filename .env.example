# Supabase usado pelo painel administrativo.
# Se estas variaveis ficarem vazias, o painel continua usando localStorage como fallback.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Chave server-side para a busca de capas de jogos no NT Admin.
# Não use prefixo VITE_ nesta variável, para não expor a chave no bundle público.
RAWG_API_KEY=

# Exemplo:
# VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=sua_chave_anon_publica
